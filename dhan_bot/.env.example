# Copy to `.env` (same folder as config.toml) and fill in. NEVER commit the real .env.
# On Linux:  chmod 600 .env

# Your Dhan client id (shown on web.dhan.co -> Profile)
DHAN_CLIENT_ID=

# Option A (dhan.auth = "token"): paste today's access token from web.dhan.co -> DhanHQ Trading APIs
DHAN_ACCESS_TOKEN=

# Option B (dhan.auth = "totp"): fully automatic daily login.
# Enable TOTP on web.dhan.co (Profile -> Security -> TOTP) and paste the *secret* (base32 text), not a 6-digit code.
DHAN_PIN=
DHAN_TOTP_SECRET=

# Option C (dhan.auth = "oauth"): API key/secret from web.dhan.co -> DhanHQ Trading APIs -> Apps
DHAN_APP_ID=
DHAN_APP_SECRET=

# Optional Telegram alerts + remote control (create a bot with @BotFather; get chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
