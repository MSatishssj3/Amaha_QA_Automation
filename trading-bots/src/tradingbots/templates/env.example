# Secrets for trading-bots. Copy to .env (`bots init` does this), keep it private (chmod 600).
# Nothing here is ever written to the settings, the tables or the logs.

# --- Dhan (only needed for platform.name = "dhan") -----------------------------------------
DHAN_CLIENT_ID=
# platform.dhan_auth = "token": paste a fresh access token here, or on the dashboard's Settings page
DHAN_ACCESS_TOKEN=
# platform.dhan_auth = "totp": automatic daily login
DHAN_PIN=
DHAN_TOTP_SECRET=

# --- Claude (the AI analyst; optional) -----------------------------------------------------
# Without a key the analyst stays off and the dashboard says how to enable it.
ANTHROPIC_API_KEY=

# --- Notifications (optional; see [notify] in config/settings.toml) ------------------------
# Telegram: create a bot with @BotFather, message it once, then read chat.id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email: STARTTLS on 587, or SMTP_SSL=true on 465. Gmail: smtp.gmail.com with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Dashboard ---------------------------------------------------------------------------------
# Set with `bots set-password` (stores a scrypt hash, never the password itself).
DASHBOARD_PASSWORD_HASH=
